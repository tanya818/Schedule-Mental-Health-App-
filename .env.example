# Copy this file to .env and fill in the values.
#
# Running with Docker (docker compose up)? You don't need a .env at all: Docker uses its
# own database and local defaults. A .env only overrides ENV, JWT_SECRET,
# GOOGLE_WEB_CLIENT_ID and ACCESS_TOKEN_MINUTES there; DATABASE_URL is ignored.

# Database, when you run uvicorn yourself (not through Docker). Pick one:
#   Homebrew Postgres on your Mac (uses your Mac username, no password):
DATABASE_URL=postgresql+psycopg://localhost:5432/mentalhealth
#   Postgres from Docker (start only the database with: docker compose up -d db):
# DATABASE_URL=postgresql+psycopg://mentalhealth:mentalhealth@localhost:5433/mentalhealth

# "development" enables POST /auth/dev-login (sign in without Google, for Postman).
# Use "production" (or remove) on a real server.
ENV=development

# Web OAuth client ID from Google Cloud Console (APIs & Services -> Credentials)
GOOGLE_WEB_CLIENT_ID=xxxx.apps.googleusercontent.com

# Secret for signing access tokens. Generate with: openssl rand -hex 32
JWT_SECRET=

ACCESS_TOKEN_MINUTES=60
