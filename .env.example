# Copy this file to .env and fill in the values.

# Homebrew Postgres uses your Mac username with no password by default.
DATABASE_URL=postgresql+psycopg://localhost:5432/mentalhealth

# "development" enables POST /auth/dev-login (sign in without Google, for Postman).
# Use "production" (or remove) on a real server.
ENV=development

# Web OAuth client ID from Google Cloud Console (APIs & Services -> Credentials)
GOOGLE_WEB_CLIENT_ID=xxxx.apps.googleusercontent.com

# Secret for signing access tokens. Generate with: openssl rand -hex 32
JWT_SECRET=

ACCESS_TOKEN_MINUTES=60
